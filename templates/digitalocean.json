{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "digitalocean": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@digitalocean/mcp",
        "--services",
        "apps,droplets,databases"
      ],
      "environment": {
        "DIGITALOCEAN_API_TOKEN": "{env:DIGITALOCEAN_API_TOKEN}"
      }
    }
  }
}