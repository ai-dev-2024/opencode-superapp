{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "google-drive": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-gdrive"
      ],
      "environment": {
        "GDRIVE_OAUTH_PATH": "{env:GDRIVE_OAUTH_PATH}",
        "GDRIVE_CREDENTIALS_PATH": "{env:GDRIVE_CREDS_PATH}"
      }
    }
  }
}